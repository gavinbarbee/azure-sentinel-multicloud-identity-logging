// Password spray against Entra ID
// One source IP failing sign-in (bad username/password, ResultType 50126)
// across several different accounts in a short window. A spray tries one
// or two common passwords against many users to stay under lockout limits,
// so the signal is "many users, one IP", not "many attempts, one user".
// Lab threshold is 3 users; production would be higher and tuned to baseline.
SigninLogs
| where ResultType == "50126"
| summarize
    FailedUsers = dcount(UserPrincipalName),
    Attempts    = count(),
    Users       = make_set(UserPrincipalName, 50),
    FirstSeen   = min(TimeGenerated),
    LastSeen    = max(TimeGenerated)
    by IPAddress, bin(TimeGenerated, 30m)
| where FailedUsers >= 3
| project FirstSeen, LastSeen, IPAddress, FailedUsers, Attempts, Users
